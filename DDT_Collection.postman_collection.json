  "item": [
    {
      "name": "CreateBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Fetch the firstname test data from DDT.csv file and set to the enviroment.\r",
              "var first_name = pm.iterationData.get('firstname');\r",
              "pm.environment.set('fName',first_name);\r",
              "\r",
              "// Fetch the lastname test data from DDT.csv file and set to the enviroment.\r",
              "var last_name = pm.iterationData.get('lastname');\r",
              "pm.environment.set('lName',last_name);\r",
              "\r",
              "// Fetch the totalprice test data from DDT.csv file and set to the enviroment.\r",
              "var total_price = pm.iterationData.get('totalprice');\r",
              "pm.environment.set('tprice',total_price);\r",
              "\r",
              "// Fetch the depositepaid test data from DDT.csv file and set to the enviroment.\r",
              "var deposite_paid = pm.iterationData.get('depositpaid');\r",
              "pm.environment.set('dpaid',deposite_paid);\r",
              "\r",
              "// Fetch the checkin test data from DDT.csv file and set to the enviroment.\r",
              "var check_in = pm.iterationData.get('checkin');\r",
              "pm.environment.set('chkindate',check_in);\r",
              "\r",
              "\r",
              "//Fetch the checkout test data from DDT.csv file and set to the enviroment.\r",
              "var check_out = pm.iterationData.get('checkout');\r",
              "pm.environment.set('chkoutdate', check_out);\r",
              "\r",
              "\r",
              "//Fetch the additionalneeds test data from DDT.csv file and set to the enviroment.\r",
              "var additional_needs = pm.iterationData.get('additionalneeds');\r",
              "pm.environment.set('additionalNeeds',additional_needs);\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Assortion for the status code to be 200.",
              "pm.test(\"Verify if the status code is 200 or not\", function (){",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "//Assortion for the response time.",
              "pm.test(\"Verify if the response time is showing as expected or not\", function (){",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "//Assortion for the response size.",
              "pm.test(\"Verify if the response size is showing as expected or not\", function (){",
              "    pm.expect(pm.response.responseSize).to.be.below(1000);",
              "});",
              "",
              "//Assortion for the firstname.",
              "var responseBody = pm.response.json();",
              "pm.environment.set(\"id\", responseBody.bookingid);",
              "",
              "pm.test(\"Verify if the first name is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('fName')).to.eql(responseBody.booking.firstname);",
              "});",
              "",
              "//Assortion for the lastname.",
              "pm.test(\"Verify if the last name is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('lName')).to.eql(responseBody.booking.lastname);",
              "});",
              "",
              "//Assortion for the totalprice.",
              "pm.test(\"Verify if the totalprice is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('tprice')).to.eql(responseBody.booking.totalprice.toString());",
              "});",
              "",
              "//Assortion for the depositpaid.",
              "pm.test(\"Verify if the depositpaid is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('dpaid')).to.eql(responseBody.booking.depositpaid.toString());",
              "});",
              "",
              "//Assortion for the checkin.",
              "pm.test(\"Verify if the checkin is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('chkindate')).to.eql(responseBody.booking.bookingdates.checkin.toString());",
              "});",
              "",
              "//Assortion for the checkout.",
              "pm.test(\"Verify if the checkout is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('chkoutdate')).to.eql(responseBody.booking.bookingdates.checkout.toString());",
              "});",
              "",
              "//Assortion for the additionalneeds.",
              "pm.test(\"Verify if the additionalneeds is showing as expected or not\", function (){",
              "pm.expect(pm.environment.get('additionalNeeds')).to.eql(responseBody.booking.additionalneeds);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"{{fName}}\",\r\n    \"lastname\" : \"{{lName}}\",\r\n    \"totalprice\" : {{tprice}},\r\n    \"depositpaid\" : {{dpaid}},\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"{{chkindate}}\",\r\n        \"checkout\" : \"{{chkoutdate}}\"\r\n    },\r\n    \"additionalneeds\" : \"{{additionalNeeds}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking",

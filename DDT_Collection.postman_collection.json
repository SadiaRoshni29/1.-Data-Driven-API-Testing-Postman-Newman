        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "//For genarating random last name\r",
              "var lastName = pm.variables.replaceIn('{{$randomLastName}}');\r",
              "pm.environment.set(\"lName\",lastName);\r",
              "\r",
              "//For genarating random first name\r",
              "var firstName = pm.variables.replaceIn('{{$randomFirstName}}');\r",
              "pm.environment.set(\"fName\",firstName);\r",
              "\r",
              "//For genarating total price\r",
              "var totalPrice = pm.variables.replaceIn('{{$randomInt}}');\r",
              "pm.environment.set(\"tprice\",totalPrice);\r",
              "\r",
              "//For genarating depositepaid\r",
              "var depositePaid = pm.variables.replaceIn('{{$randomBoolean}}');\r",
              "pm.environment.set(\"dpaid\",depositePaid);\r",
              "\r",
              "//For generating todays date as check in date\r",
              "var checkIndate = require('moment');\r",
              "console.log(checkIndate);\r",
              "var checkIndate = checkIndate() .format('YYYY-MM-DD');\r",
              "console.log(checkIndate);\r",
              "pm.environment.set(\"chkindate\",checkIndate);\r",
              "\r",
              "//For generating todays date as check out date\r",
              "var checkOutdate = require('moment');\r",
              "console.log(checkOutdate);\r",
              "var checkOutdate = checkOutdate().add(2,'d').format('YYYY-MM-DD');\r",
              "console.log(checkOutdate);\r",
              "pm.environment.set(\"chkoutdate\",checkOutdate);\r",
              "\r",
              "//For genarating additionalneeds\r",
              "var additionalNeeds = pm.variables.replaceIn('{{$randomBsNoun}}');\r",
              "pm.environment.set(\"additionalNeeds\",additionalNeeds);\r",
              "\r",
              ""
            ],
